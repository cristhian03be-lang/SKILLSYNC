# Copia este archivo como .env y completa los valores (nunca subas .env a GitHub)
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/encaja
# Cadena larga y aleatoria, por ejemplo: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Administrador que crea "npm run seed" (la clave debe tener al menos 8 caracteres)
ADMIN_EMAIL=admin@encaja.pe
ADMIN_PASSWORD=
# Scraping automático (formato cron). Vacío = solo manual desde /scraping
SCRAPING_CRON=0 6 * * *
